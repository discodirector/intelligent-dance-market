{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM"],
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "@swarm-sequencer/synth": ["../packages/synth/src/index.ts"]
    }
  },
  "include": ["src"]
}
