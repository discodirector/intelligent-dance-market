{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@deployments/*": [
        "../contracts/deployments/*"
      ],
      "@stations/*": [
        "../stations/*"
      ],
      "@swarm-sequencer/core": [
        "../packages/core/src/index.ts"
      ],
      "@swarm-sequencer/synth": [
        "../packages/synth/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}