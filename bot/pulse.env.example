# Pulse keeper (bot/src/pulse.ts). Copy to /opt/swarm-sequencer/pulse.env on the VPS, chmod 600. Never commit real keys.
# Used only by the `pulse` compose service; the bot's .env must not hold PULSE_KEY.

# PulseTreasury address (empty = the keeper logs "nothing to keep" and exits)
PULSE_TREASURY=
# Launch chain RPC (Robinhood Chain 4663)
LIVE_RPC_URL=
LIVE_CHAIN_ID=4663
# Poll interval, seconds
PULSE_TICK_SEC=60

# Fee harvest: the keeper calls LaunchFactory.claimFees(LAUNCH_NUMBER) every HARVEST_HOURS (empty = off).
# Robinhood LaunchFactory: 0xa25b02a1e93903b790e6aaf7da1b8b8d50294645; launchNumber from GET /launches/:id.
FEE_FACTORY=
LAUNCH_NUMBER=
HARVEST_HOURS=24
# Burn: treasury.burn() sends all its IDM to 0x…dEaD every BURN_HOURS (0 = off).
BURN_HOURS=24

# Dry run by default: only "true" sends transactions.
PULSE_SEND=false
# Hot wallet for gas only (0x + 64 hex). Read only when PULSE_SEND=true; never logged.
PULSE_KEY=
