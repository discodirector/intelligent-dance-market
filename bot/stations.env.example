# Stations pipeline worker (bot/src/stations/worker.ts, docs/STATIONS.md "Automatic pipeline"). Copy to
# /opt/swarm-sequencer/stations.env on the VPS, chmod 600. Used only by the `stations` compose service. Never commit
# real values. SWARM_KEY is read once from the environment and never logged (same rules as PULSE_KEY).

# Hot wallet that pays the IMD swarm (job.open / job.continue, 0.5 IMD each) on Ethereum: a NEW wallet used for nothing
# else, holding only a few IMD and a little ETH. 64 hex, with or without 0x.
SWARM_KEY=
# Ethereum RPC for balances, the Permit2 allowance and the approve (default: the registry's first Ethereum RPC).
ETH_RPC_URL=

# Telegram: a bot from @BotFather, and the owner's chat id (commands are accepted from this chat only).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Thresholds (IMD on Ethereum): warn once a day below SWARM_LOW_IMD; do not order below SWARM_MIN_IMD.
SWARM_LOW_IMD=2
SWARM_MIN_IMD=0.5
# Permit2 approve: 0 = never send it (the owner is told to approve once by hand); 1 = send an approve of
# SWARM_APPROVE_IMD when the allowance is short and the wallet holds at least SWARM_MIN_ETH.
SWARM_AUTO_APPROVE=0
SWARM_APPROVE_IMD=5
SWARM_MIN_ETH=0.002
# Styles per genre the swarm writes (1..4, default 2).
SWARM_STYLES=2

# A preview goes live by itself this many hours after it is ready, unless the owner sends /hold <key>.
STATIONS_AUTO_LIVE_HOURS=24
# Public site (preview links).
SITE_URL=https://theidm.fun
WORKER_TICK_SEC=60
# The same as api.env: the worker counts the Station+ slots to tell the owner when they are full.
STATION_PLUS_SLOTS=6
