# Stations API (bot/src/api, docs/STATIONS.md "Applications and payment"). Copy to /opt/swarm-sequencer/api.env on
# the VPS, chmod 600. Used only by the `api` compose service. No keys: the API only reads the chain.

# Receiving address for station payments (the stablecoins in bot/src/api/config.ts: Ethereum, Base, Arbitrum, Monad,
# Robinhood Chain), the owner-approved one. Empty = 503 "applications not open".
STATION_PAY_TO=0x12a7c4567eEF583ca6bC73F72aB980fd40F89CEA
# 1 = new applications and renewals are taken; anything else = only payments of quotes already given, and status.
STATIONS_OPEN=0
# launch ($50 + 1.5 IMD setup, $30 / $75 renewals) or regular ($100 + 3 IMD, $50 / $125).
STATION_PRICE_TIER=launch
# Station+ stations at a time (docs/STATIONS.md "Station+"); new Station+ quotes are refused when they are taken.
STATION_PLUS_SLOTS=6
# Browser origins allowed by CORS (the site itself calls same-origin through Caddy).
API_ORIGINS=https://theidm.fun
# 1 (default): the client IP is the last X-Forwarded-For hop (Caddy sets it; the port is bound to 127.0.0.1).
API_TRUST_PROXY=1
