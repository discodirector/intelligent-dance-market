# Copy to /opt/swarm-sequencer/.env on the VPS. Never commit real keys.

# Posting: true = only write out/queue/<ts>/{video.mp4,caption.txt,facts.json}
DRY_RUN=true

# Anthropic (captions, model claude-sonnet-5-5). Empty -> template captions.
ANTHROPIC_API_KEY=
CAPTION_MODEL=claude-sonnet-5-5

# X API v2 (user context). Either OAuth 1.0a ...
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# ... or an OAuth 2.0 user access token with tweet.write + media.write
X_OAUTH2_USER_TOKEN=

# Ethereum mainnet RPC(s) for replay teasers (comma-separated). Empty -> built-in public list.
ETH_RPC_URL=
REPLAY_POOLS=main
# Teaser windows in days, rotated per teaser
TEASER_WINDOWS=7,1,3

# Live mode (Robinhood Chain 4663). Leave empty until the hook is deployed -> pre-launch teasers.
HOOK_ADDRESS=
HOOK_START_BLOCK=
LIVE_RPC_URL=
LIVE_CHAIN_ID=4663

# Scheduler
TICK_MINUTES=5
VIDEO_SECONDS=32
