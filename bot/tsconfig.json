{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    // Workspace packages resolve to this checkout's sources (as site/vite.config.ts does), not node_modules links.
    "baseUrl": ".",
    "paths": {
      "@swarm-sequencer/core": ["../packages/core/src/index.ts"],
      "@swarm-sequencer/synth": ["../packages/synth/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}
