{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swarm-sequencer:vectors:v1",
  "title": "SPEC section 3.5 Solidity transition vectors",
  "type": "array",
  "minItems": 40,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "before",
      "input",
      "after",
      "event"
    ],
    "properties": {
      "before": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot0",
          "slot1"
        ],
        "properties": {
          "slot0": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "slot1": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          }
        }
      },
      "input": {
        "description": "Exactly one amount field: v1 (vectors.json, IMD-quoted Sepolia hook) uses imdAmt; v2 (vectors-v2.json, quote = native ETH) uses quoteAmt. Enforced by scripts/validate-vectors.py.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "isBuy",
          "tick",
          "blockNumber",
          "timestamp"
        ],
        "properties": {
          "isBuy": {
            "type": "boolean"
          },
          "imdAmt": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "quoteAmt": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "tick": {
            "type": "integer",
            "minimum": -8388608,
            "maximum": 8388607
          },
          "blockNumber": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "timestamp": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1099511627775
          }
        }
      },
      "after": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot0",
          "slot1"
        ],
        "properties": {
          "slot0": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "slot1": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          }
        }
      },
      "event": {
        "description": "Exactly one amount field: imdAmount (v1) or quoteAmount (v2), equal to the input amount. The Mutated ABI types and topic are unchanged.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sender",
          "swapCount",
          "track",
          "step",
          "on",
          "bassNote",
          "isBuy",
          "tick",
          "slot0",
          "slot1",
          "movement",
          "drop"
        ],
        "properties": {
          "sender": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "swapCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "track": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "step": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "on": {
            "type": "boolean"
          },
          "bassNote": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "isBuy": {
            "type": "boolean"
          },
          "imdAmount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "quoteAmount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "tick": {
            "type": "integer",
            "minimum": -8388608,
            "maximum": 8388607
          },
          "slot0": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "slot1": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "movement": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "patternId",
                  "root",
                  "swapCount"
                ],
                "properties": {
                  "patternId": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "root": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 11
                  },
                  "swapCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  }
                }
              }
            ]
          },
          "drop": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "track",
                  "fill",
                  "mask"
                ],
                "properties": {
                  "track": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                  },
                  "fill": {
                    "type": "boolean"
                  },
                  "mask": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  }
                }
              }
            ]
          },
          "fromTrack": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "writeStep": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "whale": {
            "type": "boolean"
          },
          "whaleWei": {
            "description": "v2 only: the whale threshold this swap was judged against, K * sqrt(FDV) from the post-swap tick (quote = currency0), clamped to [5e15, 5e19]. Not an on-chain field: clients derive it from Mutated.tick.",
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "promoted": {
            "type": "boolean"
          },
          "noop": {
            "type": "boolean"
          },
          "trackComplete": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "trackNo",
                  "patternId",
                  "root",
                  "swapCount",
                  "slot0",
                  "slot1",
                  "seed"
                ],
                "properties": {
                  "trackNo": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "patternId": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "root": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 11
                  },
                  "swapCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "slot0": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  },
                  "slot1": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  },
                  "seed": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  }
                }
              }
            ]
          }
        }
      },
      "name": {
        "type": "string"
      }
    }
  }
}
